{
  "name": "causality-cage-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "shop:build": "pnpm --filter shop build",
    "test:integration": "pnpm shop:build && playwright test",
    "test:selfcheck": "pnpm shop:build && node packages/cli/bin/cage.mjs selfcheck",
    "cage": "node packages/cli/bin/cage.mjs",
    "bench": "pnpm shop:build && node packages/cli/bin/cage.mjs bench"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.60.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
